# LLM Configuration (OpenRouter - Supports ANY model!)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL_NAME=google/gemini-1.5-pro
LLM_TEMPERATURE=0.1

# Orchestrator Configuration
MAX_HEALER_RETRIES=3

# MCP Configuration
MCP_COMMAND=node
MCP_ARGS=playwright-mcp/build/index.js

# LangSmith Configuration for Tracing and Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=aivar-hackathon
